# ==============================================================================
# Smart Parking System - Local Development Environment Template
# ==============================================================================
# PURPOSE
# - Commit THIS file (.env.example) to Git.
# - Each developer copies it to ".env" and changes values only for their machine.
# - NEVER commit ".env".
# - Values marked LOCAL DEVELOPMENT ONLY are intentionally non-production.
# - Real secrets for Google, VNPay, Mapbox, SMTP, etc. must be placed in .env
#   or injected by the deployment environment / secret manager.
#
# Quick setup (PowerShell):
#   if (-not (Test-Path .env)) { Copy-Item .env.example .env }
#
# Docker networking rule:
# - Containers talk to each other by Docker service name and CONTAINER port.
# - Tools running on Windows/macOS/Linux host use localhost and HOST port.
#
# Example PostgreSQL:
#   Inside Docker : postgres:5432
#   From host     : localhost:5433
#
# Example RabbitMQ:
#   Inside Docker : rabbitmq:5672
#   From host     : localhost:5672
# ==============================================================================


# ==============================================================================
# PostgreSQL 17
# ==============================================================================
# Service hostname used by containers on the Docker Compose network.
POSTGRES_HOST=postgres

# PostgreSQL port INSIDE Docker. Keep this at 5432 unless the container config
# itself is intentionally changed.
POSTGRES_PORT=5432

# One logical database is used for the OJT project.
# Service-owned schemas (identity, parking, booking, payment, notification)
# are created later by service-owned EF Core migrations.
POSTGRES_DB=parking_system

# LOCAL DEVELOPMENT ONLY credentials.
POSTGRES_USER=parking_dev
POSTGRES_PASSWORD=parking_dev_local_only

# Port exposed on the developer HOST machine.
# 5433 is used to avoid common Windows/local PostgreSQL conflicts on 5432.
# Host tools (pgAdmin/DBeaver/psql) connect to localhost:5433.
POSTGRES_HOST_PORT=5433

# Optional shared PostgreSQL. Keep credentials in .env only; use a direct or
# session-pooler connection. Size pools for all services and all developers.
# DATABASE_CONNECTION_STRING='Host=<host>;Port=5432;Database=postgres;Username=<user>;Password=<password>;SSL Mode=VerifyFull;Maximum Pool Size=1;Connection Idle Lifetime=60;GSS Encryption Mode=Disable'


# ==============================================================================
# RabbitMQ 4.x
# ==============================================================================
# Docker service hostname used by containers.
RABBITMQ_HOST=rabbitmq

# AMQP port INSIDE Docker.
RABBITMQ_PORT=5672

# LOCAL DEVELOPMENT ONLY credentials.
RABBITMQ_USER=parking_dev
RABBITMQ_PASSWORD=parking_dev_local_only
RABBITMQ_VHOST=/

# MQTT port INSIDE Docker.
RABBITMQ_MQTT_PORT=1883

# Ports exposed on the developer HOST machine.
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_MQTT_HOST_PORT=1883


# ==============================================================================
# API Gateway
# ==============================================================================
# Host port -> container port 8080.
GATEWAY_PORT=5000


# ==============================================================================
# Identity Service
# ==============================================================================
# Host port -> container port 8080.
IDENTITY_PORT=5001


# ==============================================================================
# Parking Service
# ==============================================================================
# Host port -> container port 8080.
PARKING_PORT=5002


# ==============================================================================
# Booking Service
# ==============================================================================
# Host port -> container port 8080.
BOOKING_PORT=5003


# ==============================================================================
# Payment Service
# ==============================================================================
# Host port -> container port 8080.
PAYMENT_PORT=5004


# ==============================================================================
# Notification Service
# ==============================================================================
# Host port -> container port 8080.
NOTIFICATION_PORT=5005


# ==============================================================================
# AI Service
# ==============================================================================
# FastAPI host port -> container port 8000.
# The AI Docker image uses Python 3.12.
AI_PORT=8000


# ==============================================================================
# VNeID Simulator
# ==============================================================================
# Host port -> container port 8000.
# Identity service routes CCCD verification through this simulator in Development.
VNEID_PORT=5010


# ==============================================================================
# IoT Simulator
# ==============================================================================
# false = simulator starts idle and does NOT generate events automatically.
# Enable only for a dedicated development/demo lot with existing car slots.
DEVICE_SIMULATION_ENABLED=false
SIM_LOT_ID=
SIM_SLOT_CODES=
SIM_INTERVAL_SECONDS=5
SIM_MODE=slot
# Required only in full-cycle mode. Use a clearly marked demo plate.
SIM_PLATE_NUMBER=
SIM_CONFIDENCE=0.97

# The simulator currently receives MQTT connection settings from the RabbitMQ
# variables above:
#   MQTT_HOST     <- RABBITMQ_HOST
#   MQTT_PORT     <- RABBITMQ_MQTT_PORT
#   MQTT_USERNAME <- RABBITMQ_USER
#   MQTT_PASSWORD <- RABBITMQ_PASSWORD
# Do not duplicate credentials here unless the Compose contract is changed.


# ==============================================================================
# Future Authentication / External Integrations
# ==============================================================================
# Leave these blank in .env.example.
# Put developer-specific values only in the local .env file.
# Never commit real credentials.

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# VNPay Sandbox / Payment integration
VNPAY_MODE=Sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Front-end page the browser returns to. VNPay calls GET /api/payment/vnpay/ipn separately, so that URL must be public.
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return

# Mapbox
MAPBOX_ACCESS_TOKEN=
# Browser maps: a PUBLIC Mapbox token (pk.*). It is compiled into the web image, so run
# `docker compose up -d --build web` after changing it. Never put a secret token here.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# SMTP / Email (Mailpit local capture by default; set SMTP_HOST=console to force console log)
MAILPIT_UI_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@parkwise.vn


# ==============================================================================
# Security
# ==============================================================================
# Do NOT put a real private key in .env.example.
# Explicit comma-separated browser origins for the Gateway. Empty allows no origins.
# Example for local frontend only: http://localhost:3000
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000

# HMAC pepper for OTP codes (Identity). Required: put your own random value, at least 32 characters.
# Easiest: run scripts/dev/Initialize-DevEnv.ps1 (fills blank secrets). Or by hand, PowerShell:
# $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
SECURITY_OTP_PEPPER=

# Service-to-service auth key shared by the Gateway and all internal services.
# Empty = validation disabled (development default).
# PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
SERVICE_KEY=

# Shared secret of the IoT slot sensors for POST /api/parking/slots/sensor-events (header X-Device-Key).
# Empty = the sensor route rejects every call. Generate one the same way as SERVICE_KEY.
SENSOR_DEVICE_KEY=

# Dedicated service-to-service key for arrival availability integration (Parking <-> Booking <-> AI).
# Empty = arrival endpoints return 503. Set for local dev/testing.
ARRIVAL_API_KEY=arrival_secret_local_dev_only

# Local AI Recommendation; "legacy" is the default, use "prompting" only with a configured model/key.
# Never commit the real API key or share `docker compose config` output containing secrets.
AI_RECOMMENDATION_MODE=legacy
AI_LLM_MODEL=
AI_LLM_API_KEY=
AI_LLM_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions
AI_LLM_TIMEOUT_SECONDS=3
AI_LLM_MAX_OUTPUT_TOKENS=400
AI_LLM_USER_AGENT=ParkWise-AI/1.0


# ==============================================================================
# Local Observability (OpenTelemetry)
# ==============================================================================
# Compose applications export traces and metrics through the Collector.
# Inside Compose, use the Collector's service name and internal gRPC port.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_RESOURCE_ATTRIBUTES=service.namespace=ParkingSystem,deployment.environment=Development

# Local Development sampling. Use a suitable lower sampling ratio in production.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# Host ports can be changed if these defaults are already occupied.
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_PORT=4318
JAEGER_UI_HOST_PORT=16686
PROMETHEUS_HOST_PORT=9090


# ==============================================================================
# Optional Local Overrides / Notes
# ==============================================================================
# If a host port is already in use, change ONLY the corresponding *_HOST_PORT
# (or API host port) in your local .env.
#
# Example:
#   POSTGRES_HOST_PORT=5434
#
# Do NOT change POSTGRES_PORT=5432 just because the host port changed.
#
# After editing .env, verify resolved Compose configuration:
#   docker compose config
#
# Start infrastructure only:
#   docker compose up -d postgres rabbitmq
#
# Start full local stack:
#   docker compose up --build
# ==============================================================================
