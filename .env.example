# ==============================================================================
# Smart Parking System - Local Development Environment Template
# ==============================================================================
# PURPOSE
# - Commit THIS file (.env.example) to Git.
# - Each developer copies it to ".env" and changes values only for their machine.
# - NEVER commit ".env".
# - Values marked LOCAL DEVELOPMENT ONLY are intentionally non-production.
# - Real secrets for Google, VNPay, Mapbox, SMTP, etc. must be placed in .env
#   or injected by the deployment environment / secret manager.
#
# Quick setup (PowerShell):
#   if (-not (Test-Path .env)) { Copy-Item .env.example .env }
#
# Docker networking rule:
# - Containers talk to each other by Docker service name and CONTAINER port.
# - Tools running on Windows/macOS/Linux host use localhost and HOST port.
#
# Example PostgreSQL:
#   Inside Docker : postgres:5432
#   From host     : localhost:5433
#
# Example RabbitMQ:
#   Inside Docker : rabbitmq:5672
#   From host     : localhost:5672
# ==============================================================================


# ==============================================================================
# PostgreSQL 17
# ==============================================================================
# Service hostname used by containers on the Docker Compose network.
POSTGRES_HOST=postgres

# PostgreSQL port INSIDE Docker. Keep this at 5432 unless the container config
# itself is intentionally changed.
POSTGRES_PORT=5432

# One logical database is used for the OJT project.
# Service-owned schemas (identity, parking, booking, payment, notification)
# are created later by service-owned EF Core migrations.
POSTGRES_DB=parking_system

# LOCAL DEVELOPMENT ONLY credentials.
POSTGRES_USER=parking_dev
POSTGRES_PASSWORD=parking_dev_local_only

# Port exposed on the developer HOST machine.
# 5433 is used to avoid common Windows/local PostgreSQL conflicts on 5432.
# Host tools (pgAdmin/DBeaver/psql) connect to localhost:5433.
POSTGRES_HOST_PORT=5433


# ==============================================================================
# RabbitMQ 4.x
# ==============================================================================
# Docker service hostname used by containers.
RABBITMQ_HOST=rabbitmq

# AMQP port INSIDE Docker.
RABBITMQ_PORT=5672

# LOCAL DEVELOPMENT ONLY credentials.
RABBITMQ_USER=parking_dev
RABBITMQ_PASSWORD=parking_dev_local_only
RABBITMQ_VHOST=/

# MQTT port INSIDE Docker.
RABBITMQ_MQTT_PORT=1883

# Ports exposed on the developer HOST machine.
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_MQTT_HOST_PORT=1883


# ==============================================================================
# API Gateway
# ==============================================================================
# Host port -> container port 8080.
GATEWAY_PORT=5000


# ==============================================================================
# Identity Service
# ==============================================================================
# Host port -> container port 8080.
IDENTITY_PORT=5001


# ==============================================================================
# Parking Service
# ==============================================================================
# Host port -> container port 8080.
PARKING_PORT=5002


# ==============================================================================
# Booking Service
# ==============================================================================
# Host port -> container port 8080.
BOOKING_PORT=5003


# ==============================================================================
# Payment Service
# ==============================================================================
# Host port -> container port 8080.
PAYMENT_PORT=5004


# ==============================================================================
# Notification Service
# ==============================================================================
# Host port -> container port 8080.
NOTIFICATION_PORT=5005


# ==============================================================================
# AI Service
# ==============================================================================
# FastAPI host port -> container port 8000.
# The AI Docker image uses Python 3.12.
AI_PORT=8000


# ==============================================================================
# IoT Simulator
# ==============================================================================
# false = simulator starts idle and does NOT generate events automatically.
# Enable explicitly only when simulation behavior has been implemented/configured.
DEVICE_SIMULATION_ENABLED=false

# The simulator currently receives MQTT connection settings from the RabbitMQ
# variables above:
#   MQTT_HOST     <- RABBITMQ_HOST
#   MQTT_PORT     <- RABBITMQ_MQTT_PORT
#   MQTT_USERNAME <- RABBITMQ_USER
#   MQTT_PASSWORD <- RABBITMQ_PASSWORD
# Do not duplicate credentials here unless the Compose contract is changed.


# ==============================================================================
# Future Authentication / External Integrations
# ==============================================================================
# Leave these blank in .env.example.
# Put developer-specific values only in the local .env file.
# Never commit real credentials.

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# VNPay Sandbox / Payment integration
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# Mapbox
MAPBOX_ACCESS_TOKEN=

# SMTP / Email
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=


# ==============================================================================
# JWT / Security (Future Phase)
# ==============================================================================
# Do NOT put a real private key in .env.example.
# When JWT RS256 is implemented, use environment variables / mounted secret files.
JWT_ISSUER=
JWT_AUDIENCE=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=


# ==============================================================================
# Observability (Future Phase)
# ==============================================================================
# Currently unused in Phase 03. Keep blank until OpenTelemetry integration is added.
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=


# ==============================================================================
# Optional Local Overrides / Notes
# ==============================================================================
# If a host port is already in use, change ONLY the corresponding *_HOST_PORT
# (or API host port) in your local .env.
#
# Example:
#   POSTGRES_HOST_PORT=5434
#
# Do NOT change POSTGRES_PORT=5432 just because the host port changed.
#
# After editing .env, verify resolved Compose configuration:
#   docker compose config
#
# Start infrastructure only:
#   docker compose up -d postgres rabbitmq
#
# Start full local stack:
#   docker compose up --build
# ==============================================================================
