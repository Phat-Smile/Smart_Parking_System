FROM mcr.microsoft.com/dotnet/sdk:10.0.302 AS sdk
FROM node:24.16.0-trixie-slim AS node
FROM python:3.12.15-slim-trixie AS python

FROM jenkins/inbound-agent:jdk21

USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git ca-certificates libicu-dev libncursesw6 libreadline8t64 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=sdk /usr/share/dotnet /usr/share/dotnet
COPY --from=python /usr/local /usr/local
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules

RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx && \
    ldconfig && \
    python3 -c 'import bz2, ctypes, lzma, readline, sqlite3, ssl, zlib'

ENV DOTNET_ROOT=/usr/share/dotnet
ENV PATH="/usr/share/dotnet:${PATH}"
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
ENV PYTHONDONTWRITEBYTECODE=1

USER jenkins
