{
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        }
      },
      "parking": {
        "ClusterId": "parking",
        "Match": {
          "Path": "/api/parking/{**catch-all}"
        }
      },
      "booking": {
        "ClusterId": "booking",
        "Match": {
          "Path": "/api/booking/{**catch-all}"
        }
      },
      "payment": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        }
      },
      "notification": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/api/notification/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "parking": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "booking": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "payment": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "notification": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5005"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
