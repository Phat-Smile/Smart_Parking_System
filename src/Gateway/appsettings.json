{
  "Security": {
    "Cors": {
      "AllowedOrigins": "http://localhost:3000"
    },
    "Jwt": {
      "Issuer": "ParkingSystem.Identity",
      "Audience": "ParkingSystem",
      "ClockSkewSeconds": 30,
      "PublicKeyPath": ".local/security/jwt/public.pem"
    }
  },
  "ServiceAuth": {
    "ServiceKey": ""
  },
  "ReverseProxy": {
    "Routes": {
      "auth-register": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth-register",
        "Match": {
          "Path": "/api/identity/accounts",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-login": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth-login",
        "Match": {
          "Path": "/api/identity/accounts/login",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-google": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth-google",
        "Match": {
          "Path": "/api/identity/accounts/google",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-refresh": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth-refresh",
        "Match": {
          "Path": "/api/identity/accounts/refresh",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-verify-email": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth-verify-email",
        "Match": {
          "Path": "/api/identity/accounts/verify-email",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-resend-otp": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth-resend-otp",
        "Match": {
          "Path": "/api/identity/accounts/resend-otp",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-forgot-password": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth-forgot-password",
        "Match": {
          "Path": "/api/identity/accounts/forgot-password",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-reset-password": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth-reset-password",
        "Match": {
          "Path": "/api/identity/accounts/reset-password",
          "Methods": [
            "POST"
          ]
        }
      },
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        }
      },
      "parking-search": {
        "ClusterId": "parking",
        "RateLimiterPolicy": "parking-search",
        "Match": {
          "Path": "/api/parking/lots/search",
          "Methods": [
            "GET"
          ]
        }
      },
      "parking-nearby": {
        "ClusterId": "parking",
        "RateLimiterPolicy": "parking-search",
        "Match": {
          "Path": "/api/parking/lots/nearby",
          "Methods": [
            "GET"
          ]
        }
      },
      "parking-recommendations": {
        "ClusterId": "parking",
        "RateLimiterPolicy": "parking-search",
        "Match": {
          "Path": "/api/parking/lots/recommendations",
          "Methods": [
            "GET"
          ]
        }
      },
      "parking": {
        "ClusterId": "parking",
        "Match": {
          "Path": "/api/parking/{**catch-all}"
        }
      },
      "parking-hub": {
        "ClusterId": "parking",
        "Match": {
          "Path": "/hubs/parking/{**catch-all}"
        }
      },
      "booking": {
        "ClusterId": "booking",
        "Match": {
          "Path": "/api/booking/{**catch-all}"
        }
      },
      "payment": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        }
      },
      "notification": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/api/notification/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        },
        "Destinations": {
          "default": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "parking": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:15"
        },
        "Destinations": {
          "default": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "booking": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        },
        "Destinations": {
          "default": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "payment": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:20"
        },
        "Destinations": {
          "default": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "notification": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:08"
        },
        "Destinations": {
          "default": {
            "Address": "http://localhost:5005"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
