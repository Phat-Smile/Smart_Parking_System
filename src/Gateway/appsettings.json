{
  "ReverseProxy": {
    "Routes": {
      "auth-register": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth-register",
        "Match": {
          "Path": "/api/identity/accounts",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-login": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth-login",
        "Match": {
          "Path": "/api/identity/accounts/login",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-google": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth-google",
        "Match": {
          "Path": "/api/identity/accounts/google",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-refresh": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth-refresh",
        "Match": {
          "Path": "/api/identity/accounts/refresh",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-verify-email": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth-verify-email",
        "Match": {
          "Path": "/api/identity/accounts/verify-email",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-resend-otp": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth-resend-otp",
        "Match": {
          "Path": "/api/identity/accounts/resend-otp",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-forgot-password": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth-forgot-password",
        "Match": {
          "Path": "/api/identity/accounts/forgot-password",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-reset-password": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth-reset-password",
        "Match": {
          "Path": "/api/identity/accounts/reset-password",
          "Methods": [
            "POST"
          ]
        }
      },
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        }
      },
      "parking": {
        "ClusterId": "parking",
        "Match": {
          "Path": "/api/parking/{**catch-all}"
        }
      },
      "booking": {
        "ClusterId": "booking",
        "Match": {
          "Path": "/api/booking/{**catch-all}"
        }
      },
      "payment": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        }
      },
      "notification": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/api/notification/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "parking": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "booking": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "payment": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "notification": {
        "Destinations": {
          "default": {
            "Address": "http://localhost:5005"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
