{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Kestrel": { "Endpoints": {
    "Http": { "Url": "http://*:8080", "Protocols": "Http1" },
    "Grpc": { "Url": "http://*:8081", "Protocols": "Http2" } } },
  "ConnectionStrings": { "DefaultConnection": "" },
  "Security": {
    "Jwt": {
      "Issuer": "ParkingSystem.Identity",
      "Audience": "ParkingSystem",
      "ClockSkewSeconds": 30,
      "PublicKeyPath": ".local/security/jwt/public.pem"
    }
  },
  "ServiceAuth": {
    "ServiceKey": ""
  },
  "DeviceAuth": {
    "SensorKey": ""
  },
  "IdentityService": {
    "GrpcEndpoint": "http://identity-api:8081",
    "TimeoutSeconds": 2
  },
  "BookingService": {
    "BaseUrl": "http://localhost:5003",
    "TimeoutSeconds": 3
  },
  "Seeding": {
    "Enabled": false,
    "Reset": false
  }
}
